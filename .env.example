# CatTogether
CT_HOST=127.0.0.1
CT_PORT=8000

# Feishu enterprise self-built app
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx
FEISHU_CONNECTION_MODE=long_connection
# Optional: makes @ parsing strict when the bot open_id is known
FEISHU_BOT_OPEN_ID=ou_xxxxxxxxxxxxxxxx
# Existing Wiki space where the bot application is an administrator/member.
# May be omitted when the app can access exactly one Wiki space.
FEISHU_WIKI_SPACE_ID=
# Optional when tenant:tenant.domain:read is granted.
FEISHU_WIKI_BASE_URL=https://example.feishu.cn/wiki

# Result delivery. Long chat answers stay in chat; Wiki is used only when the
# user explicitly asks for a document/report.
CT_CHAT_CHUNK_LIMIT=3500
CT_ARTIFACT_FINAL_MESSAGE_LIMIT=1000
CT_STRUCTURED_RUN_RESULT=true
CT_OUTPUT_INTENT_ROUTING=true
CT_CHECKPOINT_DELIVERY=true
CT_FEISHU_CARD_V2=true
# Migration switch for old Agent output containing the former final marker.
CT_LEGACY_FINAL_MARKER=true

# Role/tool isolation and delegated-run controls.
CT_STRICT_ROLE_TOOLS=true
CT_DELEGATE_MAX_DEPTH=3
CT_DELEGATE_MAX_CONCURRENCY=4
CT_DELEGATE_TIMEOUT=300

# One live card is updated; heartbeat does not create repeated text messages.
CT_FEISHU_PROGRESS_UPDATE_INTERVAL=3
CT_FEISHU_PROGRESS_HEARTBEAT_INTERVAL=30
CT_FEISHU_PROGRESS_TIMELINE_LIMIT=30
CT_CHECKPOINT_MIN_INTERVAL=30

# Optional access allowlists (comma-separated; empty means no restriction)
FEISHU_ALLOWED_TENANT_KEYS=
FEISHU_ALLOWED_CHAT_IDS=
FEISHU_ALLOWED_OPEN_IDS=

# Workspace roots that administrators may bind (comma-separated)
CT_ALLOWED_WORKSPACE_ROOTS=D:\Project

# Role bindings. Keep empty to use automatic resolution.
CT_COORDINATOR_AGENT=
CT_RESEARCH_AGENT=
CT_CODING_AGENT=claude-code
CT_REVIEWER_AGENT=
CT_COORDINATOR_MAX_REVISIONS=2
CT_TASK_WORKERS=2
CT_TASK_QUEUE_SIZE=100
# Maximum bytes accepted for one CLI output line (Codex emits JSONL)
CT_CLI_STREAM_LIMIT=16777216
